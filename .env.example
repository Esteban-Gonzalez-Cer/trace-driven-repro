# Copy to .env (gitignored) and fill in. Never commit real keys.
# LLM providers (Phase 2). Used only by the host-side agent client, never passed into sandboxes.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Live demo (Phase 6, docs/DEMO.md). Read only by tracerepro.live, never put in os.environ.
# Webhook signing secret, at least 32 characters, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
DEMO_WEBHOOK_SECRET=
# Fine-grained token scoped to your own demo fork only (Contents, Pull requests: read and write).
GITHUB_DEMO_TOKEN=
# The fork the draft PRs go to, as owner/name.
DEMO_REPO=
